[Unit]
Description=Cloudflare tunnel connector
Requires=tunna.service
After=tunna.service

[Service]
EnvironmentFile=/home/denyryn/Infra/cloudflare-tunnel/.env
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token $TUNNEL_TOKEN
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
